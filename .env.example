# 财务流水转Excel工具环境变量示例
# 复制为 .env.local 并按需填写

# 运行模式：demo（内置模拟识别，无需密钥，用于开发演示）| aws（接入 AWS Textract）
OCR_PROVIDER=demo

# ---- AWS Textract 接入（OCR_PROVIDER=aws 时必填）----
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- 订阅与计费 ----
# demo 模式通过逗号分隔的密钥列表模拟已订阅用户，生产环境需接入支付服务
SUBSCRIBER_KEYS=

NEXT_PUBLIC_APP_URL=http://localhost:3000
